{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Native Crossplane provider managers and groups; combine with the default preset.",
  "extends": [
    "docker:pinDigests"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Validate related image patches and digest refreshes in one native-provider build",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "groupName": "Container images"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "go install (?<depName>[^@\\s]+?)(?:/cmd/[^@\\s]+)?@(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/[^/]+-image\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^e2e\\.sh$/"
      ],
      "matchStrings": [
        "(?<depName>kindest/node|registry):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^e2e\\.sh$/"
      ],
      "matchStrings": [
        "--version (?<currentValue>[0-9.]+) --namespace crossplane-system"
      ],
      "datasourceTemplate": "helm",
      "depNameTemplate": "crossplane",
      "registryUrlTemplate": "https://charts.crossplane.io/stable"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/__tests__/**",
    "**/test/**",
    "**/__fixtures__/**"
  ],
  "crossplane": {
    "managerFilePatterns": [
      "/^(examples/.*|tests/provider)\\.yaml$/"
    ]
  }
}
